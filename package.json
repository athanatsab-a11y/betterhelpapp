{
  "name": "mindbridge",
  "version": "1.0.0",
  "private": true,
  "description": "MindBridge - online therapy platform (BetterHelp-style)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "NODE_ENV=production node server/index.js",
    "seed": "node server/seed.js",
    "postinstall": "npm --prefix client install --no-audit --no-fund",
    "test": "node tests/e2e.mjs",
    "build:demo": "node scripts/build-demo.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node server/seed.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.5.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jose": "^6.2.11",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.0.9",
    "pg": "^8.23.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
