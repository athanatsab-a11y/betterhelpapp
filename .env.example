# ─── Server ────────────────────────────────────────────────────────────────
PORT=3000

# Μυστικό για τα δικά μας JWT cookies (χρησιμοποιείται μόνο χωρίς Supabase Auth)
JWT_SECRET=change-me-in-production

# ─── Βάση δεδομένων ────────────────────────────────────────────────────────
# Χωρίς DATABASE_URL η εφαρμογή τρέχει τοπικά σε SQLite (φάκελος ./data).
# Με DATABASE_URL συνδέεται στο Supabase Postgres.
# Supabase → Project Settings → Database → Connection string → URI
# Χρησιμοποίησε τον pooler (θύρα 6543) για την εφαρμογή:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# και την απευθείας σύνδεση (θύρα 5432) για τα migrations, αν χρειαστεί.

# ─── Supabase Auth (server) ────────────────────────────────────────────────
# Μόλις οριστεί το SUPABASE_URL, ο server δέχεται access tokens του Supabase
# αντί για τα δικά του cookies.
# SUPABASE_URL=https://<project-ref>.supabase.co
# Μόνο για παλιά projects με συμμετρικό κλειδί (HS256):
# SUPABASE_JWT_SECRET=

# Προαιρετικά: DATA_DIR για τη θέση της τοπικής SQLite βάσης
# DATA_DIR=/var/lib/mindbridge

# ─── Βιντεοκλήσεις (WebRTC) ────────────────────────────────────────────────
# Οι κλήσεις είναι peer-to-peer· ο server μεταφέρει μόνο τη σηματοδοσία.
# Τα STUN αρκούν για τα περισσότερα δίκτυα και είναι δωρεάν:
# STUN_URLS=stun:stun.l.google.com:19302,stun:global.stun.twilio.com:3478
# Για αυστηρά εταιρικά NAT χρειάζεται TURN (π.χ. coturn, Cloudflare, Twilio):
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=
