# Ρυθμίσεις του frontend. Το Vite ενσωματώνει αυτές τις τιμές στο build,
# οπότε χρειάζονται τη στιγμή του `npm run build`.
# Supabase → Project Settings → API
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<anon public key>

# Χωρίς αυτές τις μεταβλητές η εφαρμογή χρησιμοποιεί το ενσωματωμένο
# email/password auth του API (τοπική ανάπτυξη και demo build).
